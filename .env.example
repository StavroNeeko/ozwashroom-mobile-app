# Leave both values blank for the clearly labelled sample catalogue.
# Public Storefront API token ONLY. All EXPO_PUBLIC_* values ship in the app.
# Never use an Admin API token or a private Storefront token here.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-07
EXPO_PUBLIC_SHOPIFY_DEALS_COLLECTION=special-deals
# Optional JSON map. Defaults to the six category IDs as collection handles.
EXPO_PUBLIC_SHOPIFY_CATEGORY_HANDLES={"hand-dryers":"hand-dryers","paper-towel-dispensers":"paper-towel-dispensers","soap-dispensers":"soap-dispensers","sanitary-bins":"sanitary-bins","baby-change-stations":"baby-change-stations","grab-rails":"grab-rails"}

# Optional public overrides. The official website logo is bundled by default.
# The default phone matches the official website: 1300 652 715.
# Use a PNG/JPEG logo URL that React Native can display on Android and iOS.
EXPO_PUBLIC_BRAND_LOGO_URL=
EXPO_PUBLIC_CONTACT_PHONE=1300 652 715
EXPO_PUBLIC_CONTACT_URL=https://www.ozwashroom.com.au
