{
  "expo": {
    "name": "Ozwashroom",
    "slug": "ozwashroom",
    "scheme": "ozwashroom",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ozwashroom.mobile"
    },
    "android": {
      "package": "com.ozwashroom.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Ozwashroom"
    },
    "plugins": [["expo-router", { "asyncRoutes": false }], "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
