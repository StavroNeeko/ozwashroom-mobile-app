# Live Ozwashroom catalogue configuration. Copy this file to .env locally.
# Add the PUBLIC Storefront API token from Shopify's Headless channel before starting Expo.
# Never put an Admin API token or private Storefront token in EXPO_PUBLIC_* values.
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=ozwashroom.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-07
# This public website collection currently has products; flash-sale is empty.
EXPO_PUBLIC_SHOPIFY_DEALS_COLLECTION=flash-sale-1
EXPO_PUBLIC_SHOPIFY_CATEGORY_HANDLES={"hand-dryers":"hand-dryers","paper-towel-dispensers":"paper-towel-dispensers","soap-dispensers":"soap-dispensers","sanitary-bins":"sanitary-bins","baby-change-stations":"baby-change-table","grab-rails":"grab-rail"}

EXPO_PUBLIC_BRAND_LOGO_URL=
EXPO_PUBLIC_CONTACT_PHONE=1300 652 715
EXPO_PUBLIC_CONTACT_URL=https://www.ozwashroom.com.au
